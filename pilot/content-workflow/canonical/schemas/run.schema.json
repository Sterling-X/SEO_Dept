{
  "$comment": "Documentation-grade schema for run.json (content-workflow-run/v1). Validated by scripts/readiness_check.py with a hand-written checker; no external jsonschema dependency. Research evidence records live in <run>/research/ (schema research-record.schema.json).",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "client",
    "jurisdiction",
    "page_type",
    "voice",
    "skills",
    "sources",
    "draft",
    "export",
    "citations",
    "reviews",
    "rounds"
  ],
  "properties": {
    "schema": {
      "const": "content-workflow-run/v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
    },
    "fixture": {
      "type": "boolean",
      "description": "true only for test fixtures; review records in a fixture run must also carry fixture: true"
    },
    "client": {
      "type": "object",
      "required": [
        "name",
        "domain",
        "slug"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "domain": {
          "type": "string"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      }
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 2
    },
    "page_type": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "situational",
            "core-hub",
            "procedural",
            "service-area",
            "blog",
            "other"
          ]
        },
        "architecture_node_id": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "excluded_intents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "word_target": {
          "type": "string",
          "description": "consumer-copy word target from the pinned skill, e.g. 1,100–1,700"
        }
      }
    },
    "voice": {
      "type": "object",
      "required": [
        "skill",
        "approved_brief_source_id"
      ],
      "properties": {
        "skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_brief_source_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "repository-relative path to SKILL.md"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "files": {
            "type": "object",
            "description": "sha256 of every required_files entry of the skill's pilot-manifest.json (written by pin.py; compared at intake)"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "sha256",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "run-relative path"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "client-facts",
              "voice-brief",
              "legal-authority",
              "brief",
              "other"
            ]
          },
          "url": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "verified_on": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^EV[0-9]{1,3}$"
            },
            "description": "required (non-empty) for kind client-facts: the first-party pages retrieved in this run that the approved facts were checked against"
          }
        }
      }
    },
    "draft": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        }
      }
    },
    "export": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "validators": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "command"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "command": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "citations": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "url",
          "source_id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          }
        }
      }
    },
    "reviews": {
      "type": "object",
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "enum": [
              "legal-final",
              "editorial-final",
              "mechanical-final",
              "legal-checkpoint",
              "editorial-checkpoint"
            ]
          }
        }
      },
      "description": "the floor is computed from the run (legal-predraft, both checkpoints, the three finals, and render-final for a DOCX export on family-law page kinds); this list may only add kinds"
    },
    "rounds": {
      "type": "object",
      "required": [
        "max_repair_rounds"
      ],
      "properties": {
        "max_repair_rounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "forbidden_terms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parity": {
      "type": "object",
      "properties": {
        "word_count_tolerance": {
          "type": "number",
          "default": 0.02,
          "maximum": 0.02
        },
        "compare_headings": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "citations_ceiling_rationale": {
      "type": "string",
      "description": "required (40+ chars) when more than six citations are declared: which material claims need the additional authorities"
    },
    "research": {
      "type": "object",
      "required": [
        "nonce",
        "opened_at"
      ],
      "description": "issued once per run by scripts/research_fetch.py --init; every research/EV<n>.json record must carry this nonce and a retrieved_at on or after opened_at",
      "properties": {
        "nonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{32,}$"
        },
        "opened_at": {
          "type": "string"
        },
        "opened_by": {
          "type": "string"
        },
        "max_age_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 14
        }
      }
    },
    "link_destinations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "internal link destinations the page will carry (parent hub, process bridge, CTA); each needs a link-destination research record retrieved in this run with zero redirects (RESEARCH_MISSING otherwise)"
    }
  }
}
