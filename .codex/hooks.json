{
  "description": "Project reminders for SEO lesson routing and curated MemPalace recall and retention.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/seo-learning-loop-v1.py\"",
            "timeout": 3,
            "statusMessage": "Checking relevant SEO lessons",
            "additionalContextLimit": 900
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/mempalace-recall-retention-reminder-v3.py\"",
            "timeout": 3,
            "additionalContextLimit": 5200
          }
        ]
      }
    ]
  }
}
